# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — local development default is SQLite.
# For Supabase, set DATABASE_URL to your PostgreSQL connection string, e.g.:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# or the direct connection:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Frontend origin for CORS (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Media storage (Django-managed — never Supabase Storage)
# Development default stores uploads on disk in backend/media/ served at /media/
MEDIA_URL=/media/
MEDIA_ROOT=
SERVE_MEDIA=True
# Production persistent S3-compatible storage (AWS S3, Cloudflare R2, Spaces, etc.)
USE_S3_MEDIA=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Demo accounts — used ONLY by `python manage.py setup_demo_accounts`.
# If unset, the command prompts interactively (input is hidden).
DEMO_CANDIDATE_PASSWORD=
DEMO_COMPANY_PASSWORD=
DEMO_ADMIN_PASSWORD=
